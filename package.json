{
  "name": "dsh-git-bar",
  "version": "1.0.0",
  "description": "Git capsule for the DeepSeek Harness Web GUI: branch and working-tree changes in the session header, a commit graph with branch/tag checkout, and per-file diff review in the right sidebar.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "git-graph",
    "diff",
    "plugin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/PLUGIN.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
